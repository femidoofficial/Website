# Google Sheets API Credentials
# Service Account Email created in Google Cloud Console
GOOGLE_CLIENT_EMAIL=your-service-account-email@your-project.iam.gserviceaccount.com

# Service Account Private Key (keep quotes and handle \n line breaks)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Google Sheet Spreadsheet ID (extracted from sheet URL: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit)
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Gmail SMTP Email Notification Credentials
# Gmail address sending the notification emails
EMAIL_USER=your_email@gmail.com

# Gmail 16-character App Password (generated from Google Account -> Security -> 2-Step Verification -> App passwords)
EMAIL_APP_PASSWORD=your_16_digit_app_password

# Destination email address to receive contact form submissions
EMAIL_TO=femidoofficial@gmail.com
